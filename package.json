{
  "name": "parley",
  "version": "0.1.0",
  "private": true,
  "description": "Parley (Arbeitstitel) – Ende-zu-Ende-verschlüsselte Chat-/Voice-/Video-Plattform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @parley/shared && npm run build -w @parley/api && npm run build -w @parley/voice && npm run build -w @parley/web",
    "build:shared": "npm run build -w @parley/shared",
    "dev": "npm run build:shared && npm run dev:infra && npm run prisma:deploy && concurrently -k -n api,voice,web -c blue,magenta,green npm:dev:api npm:dev:voice npm:dev:web",
    "dev:infra": "node scripts/ensure-infra.mjs",
    "dev:api": "npm run dev -w @parley/api",
    "dev:web": "npm run dev -w @parley/web",
    "dev:voice": "npm run dev -w @parley/voice",
    "start:api": "npm run start -w @parley/api",
    "start:voice": "npm run start -w @parley/voice",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.62.0"
  }
}
