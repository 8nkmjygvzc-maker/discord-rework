# Vorlage für die .env auf dem VPS (liegt neben docker-compose.yml, z. B. in
# ~/parley/.env). Einmalig anlegen, Werte setzen – NIEMALS committen.
# Anleitung: siehe DEPLOY.md im Repo-Root.

# --- Images (GHCR) ---
# Präfix der Images, die der GitHub-Actions-Workflow pusht.
IMAGE_PREFIX=ghcr.io/8nkmjygvzc-maker/parley
# latest = jeweils letzter main-Stand. Für ein Rollback auf einen bestimmten
# Commit den 40-stelligen Git-SHA eintragen und `docker compose up -d` ausführen.
IMAGE_TAG=latest

# --- Web ---
# Wohin der Web-Container auf dem Host gebunden wird. Nur localhost –
# öffentlich macht ihn der Reverse Proxy (TLS). Port bei Konflikt anpassen.
WEB_BIND=127.0.0.1:8080
# Vertrauenswürdige Proxy-Hops vor der API (Reverse Proxy + Web-nginx = 2).
TRUST_PROXY=2
# Docker-Netzwerk eines bereits vorhandenen Reverse-Proxy-Containers (z. B.
# Caddy einer anderen Website auf demselben VPS), damit er den Web-Container
# per Name erreichen kann. Ermitteln mit:
#   docker inspect <bestehender-proxy-container> --format '{{json .NetworkSettings.Networks}}'
# Muss bereits existieren – wird von diesem Compose-Projekt NICHT angelegt.
EXTERNAL_PROXY_NETWORK=nexora-net

# --- Auth ---
# Generieren mit:  openssl rand -hex 64
JWT_SECRET=

# --- PostgreSQL (nur intern erreichbar) ---
POSTGRES_USER=parley
# Generieren mit:  openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=parley

# --- MinIO (nur intern erreichbar) ---
MINIO_ROOT_USER=parley
# Generieren mit:  openssl rand -hex 32
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=parley-attachments

# --- Voice-SFU / WebRTC ---
# Öffentliche IPv4 des VPS (Pflicht!) – z. B. via:  curl -4 ifconfig.me
MEDIASOUP_ANNOUNCED_IP=
# UDP/TCP-Portbereich für Medienströme – muss in der Firewall offen sein.
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# --- Web-Push (optional; leer = Push deaktiviert, App läuft normal) ---
# Schlüsselpaar einmalig erzeugen, z. B. auf dem VPS:
#   docker run --rm node:22-bookworm-slim npx -y web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:arianb208@gmail.com
