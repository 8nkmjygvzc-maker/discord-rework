// Datenmodell (wächst phasenweise per Migration):
// Phase 1: User, RefreshToken – Phase 3: Server, Membership, Channel –
// Phase 4: Message – Phase 6: Device, KeyEnvelope – Phase 7: Friendship, DmMember –
// Phase 8: Attachment – Phase 10: VoiceSession

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  // Frei wählbarer Status-Text fürs Profil; Online-Presence läuft über Redis.
  status       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  ownedServers    Server[]       @relation("OwnedServers")
  memberships     Membership[]
  messages        Message[]
  device          Device?
  envelopesFrom   KeyEnvelope[]  @relation("EnvelopesFrom")
  envelopesTo     KeyEnvelope[]  @relation("EnvelopesTo")
  friendshipsFrom Friendship[]   @relation("FriendshipsFrom")
  friendshipsTo   Friendship[]   @relation("FriendshipsTo")
  dmMemberships   DmMember[]
  attachments     Attachment[]
  voiceSession    VoiceSession?
  invitesCreated  Invite[]           @relation("InviteCreator")
  pushSubs        PushSubscription[]
}

// Phase 7: Freundschaften. `userId` ist der Initiator des AKTUELLEN Zustands –
// der Anfragende bei PENDING, der Blockierende bei BLOCKED. ACCEPTED gilt in
// beide Richtungen. Zwischen zwei Nutzern kann es höchstens eine Zeile pro
// Richtung geben; gegenseitige BLOCKED-Zeilen sind erlaubt.
enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("FriendshipsFrom", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User             @relation("FriendshipsTo", fields: [friendId], references: [id], onDelete: Cascade)
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, friendId])
  @@index([friendId])
}

// Phase 7: Teilnehmer eines DM-Kanals (v1: genau zwei, Gruppen-DMs später).
model DmMember {
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

// Phase 6: Öffentliche Schlüssel eines Geräts. v1 = genau EIN Gerät pro
// Account (userId unique); Multi-Device steht in der ROADMAP. Private
// Schlüssel existieren nur im Client (IndexedDB) – nie hier.
model Device {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityKey            String
  signedPreKey           String
  signedPreKeySignature  String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Phase 6: Mailbox für Ende-zu-Ende-verschlüsselte Schlüssel-Umschläge
// (Sender-Key-Verteilung). Der Server sieht nur den verschlüsselten Payload;
// der Empfänger löscht den Umschlag nach Verarbeitung (Ack).
model KeyEnvelope {
  id         String   @id @default(uuid())
  fromUserId String
  from       User     @relation("EnvelopesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  to         User     @relation("EnvelopesTo", fields: [toUserId], references: [id], onDelete: Cascade)
  payload    Json
  createdAt  DateTime @default(now())

  @@index([toUserId, createdAt])
}

model Server {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  // Kein Cascade: ein Server soll nicht stillschweigend verschwinden, wenn der
  // Owner-Account gelöscht wird – Ownership-Übergabe kommt mit Phase 13/15.
  owner     User     @relation("OwnedServers", fields: [ownerId], references: [id])
  iconUrl   String?
  createdAt DateTime @default(now())

  members  Membership[]
  channels Channel[]
  roles    Role[]
  invites  Invite[]
}

model Membership {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId String
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  nickname String?
  joinedAt DateTime @default(now())

  roles MemberRole[]

  @@id([userId, serverId])
  @@index([serverId])
}

// Phase 5: Rollen mit Berechtigungs-Bitfield. Jeder Server hat genau eine
// Standardrolle (isDefault) – sie gilt implizit für alle Mitglieder.
model Role {
  id          String   @id @default(uuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name        String
  permissions BigInt   @default(0)
  color       String?
  position    Int      @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  members MemberRole[]

  @@index([serverId])
}

// Zuweisung Rolle ↔ Mitglied (Standardrolle braucht keine Einträge).
model MemberRole {
  userId     String
  serverId   String
  roleId     String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [userId, serverId], references: [userId, serverId], onDelete: Cascade)

  @@id([userId, serverId, roleId])
  @@index([roleId])
}

enum ChannelType {
  TEXT
  VOICE
  VIDEO
  DM
}

model Channel {
  id        String      @id @default(uuid())
  // null bei Direktnachrichten (Phase 7) – DM-Kanäle gehören keinem Server.
  serverId  String?
  server    Server?     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type      ChannelType @default(TEXT)
  name      String
  position  Int         @default(0)
  isPrivate Boolean     @default(false)
  // Kanonischer Schlüssel eines DM-Paars ("kleinereId:größereId") – der
  // Unique-Index verhindert doppelte DM-Kanäle bei gleichzeitigem Öffnen.
  dmKey     String?     @unique
  createdAt DateTime    @default(now())

  messages      Message[]
  dmMembers     DmMember[]
  attachments   Attachment[]
  voiceSessions VoiceSession[]

  @@index([serverId])
}

// Phase 10: Wer sitzt gerade in welchem Sprachkanal. Ephemerer Zustand – die
// API ist die Autorität (Roster + VOICE_STATE_UPDATE), der SFU-Service verwaltet
// nur die Medien-Peers. `userId` ist unique: ein Nutzer ist zu einem Zeitpunkt
// in höchstens EINEM Sprachkanal (wie Discord). Bewusste Abweichung von
// CLAUDE.md §5: kein `sfuPeerId` – die Peer-Identität lebt im SFU, nicht in der
// DB. Beim API-Start werden verwaiste Sessions geleert (siehe VoiceService).
model VoiceSession {
  id        String   @id @default(uuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  muted     Boolean  @default(false)
  deafened  Boolean  @default(false)
  // Phase 11: Kamera-Video / Bildschirmfreigabe aktiv (nur Roster-Anzeige – die
  // Medien-Wahrheit liegt beim SFU). Beim (Neu-)Beitritt zurückgesetzt.
  cameraOn  Boolean  @default(false)
  screenOn  Boolean  @default(false)
  joinedAt  DateTime @default(now())

  @@index([channelId])
}

// Phase 6: Ende-zu-Ende-verschlüsselt. Der Server speichert nur Ciphertext,
// Nonce und den Klartext-Header (keyId/Iteration/Signatur des Sender-Keys) –
// Inhalte kann er prinzipbedingt nicht lesen.
model Message {
  id         String    @id @default(uuid())
  channelId  String
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User      @relation(fields: [senderId], references: [id])
  ciphertext String
  nonce      String
  header     Json
  createdAt  DateTime  @default(now())
  editedAt   DateTime?

  attachments Attachment[]

  // History-Abfragen laden „die letzten N vor Zeitpunkt X eines Kanals“.
  @@index([channelId, createdAt])
}

// Phase 8: Verschlüsselte Anhänge. Der Server speichert nur den Ciphertext-Blob
// in MinIO (objectKey) und die Blob-Größe. Dateischlüssel, Dateiname und
// MIME-Typ stehen IM E2EE-verschlüsselten Nachrichtentext – bewusste Abweichung
// vom Ausgangsmodell in CLAUDE.md §5 (dort mimeType/encryptedFileUrl als
// Server-Spalten), damit der Server auch diese Metadaten nicht sieht.
model Attachment {
  id         String   @id @default(uuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  // null zwischen Upload und Senden der Nachricht; wird beim Senden gesetzt.
  messageId  String?
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Objektname im MinIO-Bucket (der Blob selbst liegt nie in der DB).
  objectKey  String   @unique
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([messageId])
  @@index([channelId])
}

// Refresh-Tokens werden nur als SHA-256-Hash gespeichert: Ein DB-Leak allein
// erlaubt damit keine Session-Übernahme. Rotation bei jedem Refresh.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// Phase 12: Einladungslinks. Kurzer Code → Server, optional mit Ablauf
// (expiresAt) und/oder Nutzungslimit (maxUses; null = unbegrenzt). Ersetzt den
// offenen „Beitritt per Server-ID“ aus Phase 3 als bevorzugten Weg.
model Invite {
  code      String    @id
  serverId  String
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy String
  creator   User      @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([serverId])
}

// Phase 12: Web-Push-Subscription eines Geräts (Service Worker + VAPID). Der
// Server speichert nur den öffentlichen Endpoint + die öffentlichen
// Client-Schlüssel; damit kann er inhaltsarme Pushes an den Push-Dienst senden.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
