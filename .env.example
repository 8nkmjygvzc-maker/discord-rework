# Vorlage für die lokale .env-Datei. Kopieren nach `.env` und Werte anpassen.
# Die .env-Datei ist gitignored – niemals echte Secrets committen.

# --- API ---
API_PORT=3001
# Reverse-Proxy-Vertrauen (Phase 14). Leer im Dev (ohne Proxy). Hinter einem
# Reverse-Proxy die Zahl der vertrauenswürdigen Hops setzen (meist `1`), damit
# `req.ip` aus X-Forwarded-For kommt und das Rate-Limit pro echter Client-IP greift.
TRUST_PROXY=

# --- Auth ---
# Mit z. B. `openssl rand -hex 64` generieren – niemals den Beispielwert verwenden!
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_HEX

# --- PostgreSQL ---
POSTGRES_USER=parley
POSTGRES_PASSWORD=parley_dev_password
POSTGRES_DB=parley
DATABASE_URL=postgresql://parley:parley_dev_password@localhost:5432/parley

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-kompatibler Objektspeicher) ---
MINIO_ROOT_USER=parley
MINIO_ROOT_PASSWORD=parley_dev_password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# Bucket für verschlüsselte Anhänge (wird beim API-Start automatisch angelegt).
MINIO_BUCKET=parley-attachments
MINIO_USE_SSL=false

# --- Voice-SFU (Phase 10) ---
# Port der Signaling-WebSocket des mediasoup-SFU (apps/voice).
VOICE_PORT=3002
# URL, unter der der Client die Voice-WS erreicht. Im Dev per Vite-Proxy: /voice.
VOICE_PUBLIC_URL=/voice
# IP, an der mediasoup lauscht (0.0.0.0 für alle Interfaces).
MEDIASOUP_LISTEN_IP=127.0.0.1
# Öffentlich erreichbare IP für die ICE-Kandidaten. Auf einer Maschine (Dev)
# leer lassen (dann 127.0.0.1). Für LAN/Server die erreichbare IP eintragen.
MEDIASOUP_ANNOUNCED_IP=
# UDP/TCP-Portbereich für die WebRTC-Medienströme (in der Firewall öffnen).
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# --- Web-Push-Benachrichtigungen (Phase 12) ---
# VAPID-Schlüsselpaar für Web Push. Einmalig erzeugen mit:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Fehlen die Schlüssel, ist Push deaktiviert (die App läuft normal weiter).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt-URI für den Push-Dienst (mailto: oder https:).
VAPID_SUBJECT=mailto:admin@parley.local
