# Vorlage für die lokale .env-Datei. Kopieren nach `.env` und Werte anpassen.
# Die .env-Datei ist gitignored – niemals echte Secrets committen.

# --- API ---
API_PORT=3001

# --- PostgreSQL ---
POSTGRES_USER=parley
POSTGRES_PASSWORD=parley_dev_password
POSTGRES_DB=parley
DATABASE_URL=postgresql://parley:parley_dev_password@localhost:5432/parley

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-kompatibler Objektspeicher) ---
MINIO_ROOT_USER=parley
MINIO_ROOT_PASSWORD=parley_dev_password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
